; 331  :     value_type _Myval; // the stored value, unused if head
; 332  : 
; 333  :     enum _Redbl { // colors for link to parent
; 334  :         _Red,
; 335  :         _Black
; 336  :     };
; 337  : 
; 338  :     _Tree_node(const _Tree_node&) = delete;
; 339  :     _Tree_node& operator=(const _Tree_node&) = delete;
; 340  : 
; 341  :     template <class _Alloc>
; 342  :     static _Nodeptr _Buyheadnode(_Alloc& _Al) {
; 343  :         static_assert(is_same_v<typename _Alloc::value_type, _Tree_node>, "Bad _Buyheadnode call");
; 344  :         const auto _Pnode = _Al.allocate(1);
; 345  :         _Construct_in_place(_Pnode->_Left, _Pnode);
; 346  :         _Construct_in_place(_Pnode->_Parent, _Pnode);
; 347  :         _Construct_in_place(_Pnode->_Right, _Pnode);
; 348  :         _Pnode->_Color = _Black;
; 349  :         _Pnode->_Isnil = true;
; 350  :         return _Pnode;
; 351  :     }
; 352  : 
; 353  :     template <class _Alloc, class... _Valty>
; 354  :     static _Nodeptr _Buynode(_Alloc& _Al, _Nodeptr _Myhead, _Valty&&... _Val) {
; 355  :         // allocate a node with defaults and set links and value
; 356  :         static_assert(is_same_v<typename _Alloc::value_type, _Tree_node>, "Bad _Buynode call");
; 357  :         _Alloc_construct_ptr<_Alloc> _Newnode(_Al);
; 358  :         _Newnode._Allocate();
; 359  :         allocator_traits<_Alloc>::construct(_Al, _STD addressof(_Newnode._Ptr->_Myval), _STD forward<_Valty>(_Val)...);
; 360  :         _Construct_in_place(_Newnode._Ptr->_Left, _Myhead);
; 361  :         _Construct_in_place(_Newnode._Ptr->_Parent, _Myhead);
; 362  :         _Construct_in_place(_Newnode._Ptr->_Right, _Myhead);
; 363  :         _Newnode._Ptr->_Color = _Red;
; 364  :         _Newnode._Ptr->_Isnil = false;
; 365  :         return _Newnode._Release();
; 366  :     }
; 367  : 
; 368  :     template <class _Alloc>
; 369  :     static void _Freenode0(_Alloc& _Al, _Nodeptr _Ptr) noexcept {
; 370  :         static_assert(is_same_v<typename _Alloc::value_type, _Tree_node>, "Bad _Freenode0 call");
; 371  :         _Destroy_in_place(_Ptr->_Left);
; 372  :         _Destroy_in_place(_Ptr->_Parent);
; 373  :         _Destroy_in_place(_Ptr->_Right);
; 374  :         allocator_traits<_Alloc>::deallocate(_Al, _Ptr, 1);
; 375  :     }
; 376  : 
; 377  :     template <class _Alloc>
; 378  :     static void _Freenode(_Alloc& _Al, _Nodeptr _Ptr) noexcept {
; 379  :         static_assert(is_same_v<typename _Alloc::value_type, _Tree_node>, "Bad _Freenode call");
; 380  :         allocator_traits<_Alloc>::destroy(_Al, _STD addressof(_Ptr->_Myval));
; 381  :         _Freenode0(_Al, _Ptr);
; 382  :     }
; 383  : };
