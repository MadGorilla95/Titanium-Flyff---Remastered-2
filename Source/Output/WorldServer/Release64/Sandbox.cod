; 4522 : #pragma warning(disable : 4806) // no value of type 'bool' promoted to type 'char' can equal the given constant
; 4523 : template <class _Elem1, class _Elem2,
; 4524 :     bool = sizeof(_Elem1) == sizeof(_Elem2) //
