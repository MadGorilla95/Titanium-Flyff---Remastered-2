; 4545 : template <class _Elem1, class _Elem2>
; 4546 : _INLINE_VAR constexpr bool _Can_memcmp_elements<_Elem1, _Elem2, false> = false;
; 4547 : 
; 4548 : // _Pred_is_consistent_with_memcmp<_Elem1, _Elem2, _Pr> reports whether `_Pr(_Elem1, _Elem2)` returns
