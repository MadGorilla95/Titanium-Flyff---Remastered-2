; 4534 : // However, std::byte is C++17 and above so we are safe.
; 4535 : template <>
; 4536 : inline constexpr bool _Can_memcmp_elements<byte, byte, false> = true;
; 4537 : #endif // __cpp_lib_byte
; 4538 : 
; 4539 : // Pointer elements are eligible for memcmp when they point to the same type, ignoring cv-qualification.
; 4540 : // This handles pointers to object types, pointers to void, and pointers to function types.
; 4541 : // Performance note: This doesn't attempt to handle `object* == void*`.
