; 4526 :         && is_integral_v<_Elem2> && !is_volatile_v<_Elem2>>
; 4527 : _INLINE_VAR constexpr bool _Can_memcmp_elements =
; 4528 :     is_same_v<_Elem1, bool> || is_same_v<_Elem2, bool> || static_cast<_Elem1>(-1) == static_cast<_Elem2>(-1);
; 4529 : #pragma warning(pop)
