; 276  : 			D3DXVec3Normalize( &( vPickRayDir ), &( vPickRayDir ) );
; 277  : 			if( Pick( &vPosCam, &vPickRayDir, &vIntersect, &fDist, FALSE, FALSE ) )
; 278  : 			{
