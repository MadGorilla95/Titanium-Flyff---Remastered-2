; 262  : 		{
; 263  : 			vPosCam = m_pWorld->m_pCamera->m_vPos;
; 264  : 			vPosObj = GetPos() - vPosCam;
; 265  : 			vPosAct = GetActiveObj()->GetPos() - vPosCam;
; 266  : 			fLengthObj = D3DXVec3LengthSq( &vPosObj );	// Length를 LengthSq로 바꿈. xuzhu
; 267  : 			fLengthAct = D3DXVec3LengthSq( &vPosAct );
; 268  : 		}		
; 269  : 		// 카메라와 졸라 근접한 경우  
