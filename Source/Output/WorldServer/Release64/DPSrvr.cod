; 385  : template <class _Ty>
; 386  : struct _Tree_simple_types : _Simple_types<_Ty> {
; 387  :     using _Node    = _Tree_node<_Ty, void*>;
; 388  :     using _Nodeptr = _Node*;
; 389  : };
