; 434  : 
; 435  :     _Tree_val() noexcept : _Myhead(), _Mysize(0) {}
; 436  : 
; 437  :     enum _Redbl { // colors for link to parent
; 438  :         _Red,
; 439  :         _Black
; 440  :     };
