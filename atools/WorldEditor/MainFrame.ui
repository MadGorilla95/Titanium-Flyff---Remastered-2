       <property name="styleSheet">
        <string notr="true">#gameElementsTree 
{
    border-top: 1px solid #3f3828;
    border-right: 1px solid #3f3828;
	background-image: url(:/MainFrame/Resources/Icons_New/background.png);
}

QTreeView::item:open {
    color: #a82414;
}



QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings  {
	image: url(:/MainFrame/Resources/Icons_New/Tab_Arrow.png);
	color: #a82414;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
	image: url(:/MainFrame/Resources/Icons_New/Tab_Arrow2.png);
	color: #a82414;
}

 QScrollBar:vertical {
     background: #1d1d1e;
     width: 15px;
     margin: 22px 0 22px 0;
 }
 QScrollBar::handle:vertical {
     background: #202325;
     min-height: 20px;
 }
 QScrollBar::add-line:vertical {
     background: #202325;
     height: 20px;
     subcontrol-position: bottom;
     subcontrol-origin: margin;
 }

 QScrollBar::sub-line:vertical {
     background: #202325;
     height: 20px;
     subcontrol-position: top;
     subcontrol-origin: margin;
 }
 QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
     width: 3px;
     height: 3px;
     background: #907a4e;
 }

 QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
     background: none;
 }

 QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
     background: none;
 }</string>
       </property>
