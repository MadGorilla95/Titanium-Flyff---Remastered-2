border: 1px solid #3f3828;

}

QTabBar::tab {
    background: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0, stop:0 rgba(45, 45, 46, 255), stop:1 rgba(37, 40, 43, 255));
border: 1px solid rgb(29, 29, 30);
    padding: 2px;
 	height: 30px;
min-width: 15ex;
}

QTabBar::tab:selected, QTabBar::tab:hover {
    background: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0, stop:0 rgba(37, 37, 38, 255), stop:1 rgba(27, 29, 31, 255));
}

QTabBar::tab:selected {
    border-color: #1b1d1f;
    border-bottom-color: #363a3a; /* same as pane color */

}
QGridLayout {
    border: 1px solid gray;
    border-radius: 3px;
    margin-top: 0.5em;
	border-color: rgb(131, 111, 71);
}

QComboBox QAbstractItemView {
	
	selection-background-color: rgb(45, 45, 46);
}

QSpinBox::down-button {
