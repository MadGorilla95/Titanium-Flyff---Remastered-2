      <widget class="QGroupBox" name="groupBox">
       <property name="styleSheet">
        <string notr="true">QGroupBox {
    border: 1px solid gray;
    border-radius: 3px;
    margin-top: 0.5em;
	border-color: rgb(131, 111, 71);
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px 0 3px;
}

QPushButton::checked {
	background-color: rgb(168, 0, 0);
}


QComboBox {
	border: 1px solid #333333;
	border-radius: 3px;
	background: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0, stop:0 rgba(45, 45, 46, 255), stop:1 rgba(37, 40, 43, 255));
	padding: 1px 23px 1px 3px;
	min-width: 6em;
	color: #ffffff;
	selection-background-color: rgb(41, 41, 42, 30);
}
QComboBox::drop-down {
	subcontrol-origin: padding;
	subcontrol-position: top right;
	width: 20px;
 
	border-top-right-radius: 3px;
	border-bottom-right-radius: 3px;
}

QComboBox::down-arrow {
image: url(:/MainFrame/Resources/Icons_New/external-down-arrow-arrow-flatart-icons-lineal-color-flatarticons-10.png);
height: 14px;

}
 
QComboBox::QAbstractItemView{
	background-color: #4f4f4f;
	color: #999999;
}

QComboBox::item:pressed { 
background: rgb(61, 61, 61);
}
QComboBox::item:selected { 
background: rgb(61, 61, 61);
}


 QScrollBar:vertical {
     background: #1d1d1e;
     width: 15px;
     margin: 22px 0 22px 0;
 }
 QScrollBar::handle:vertical {
     background: #202325;
     min-height: 20px;
 }
 QScrollBar::add-line:vertical {
     background: #202325;
     height: 20px;
     subcontrol-position: bottom;
     subcontrol-origin: margin;
 }

 QScrollBar::sub-line:vertical {
     background: #202325;
     height: 20px;
     subcontrol-position: top;
     subcontrol-origin: margin;
 }
 QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
     width: 3px;
     height: 3px;
     background: #907a4e;
 }

 QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
     background: none;
 }
</string>
